{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:web",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/sub-way-stand/dist",
  "regions": ["icn1"],
  "functions": { "api/**/*.ts": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/ride", "destination": "/index.html" },
    { "source": "/evidence", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), accelerometer=(self), gyroscope=(self)" }
      ]
    }
  ]
}

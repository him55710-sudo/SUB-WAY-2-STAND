/** Reproduce the bundled real-track segment without network or dependencies.
 * node --experimental-strip-types scripts/import-line2-centerline.mts
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { orderOsmCenterline, segmentFromCenterline } from '../data/centerlineGeometry.ts';

const sourceUrl = new URL('../data/sources/line2-jamsil-osm.json', import.meta.url);
const data = JSON.parse(readFileSync(sourceUrl, 'utf8').replace(/^\uFEFF/, ''));
// Named OSM public_transport=stop_position nodes, on the same connected track.
// A representative mapped alignment; directional rail/platform is unverified.
const path = orderOsmCenterline(data, 8337914284, 5933687061);
const forward = segmentFromCenterline({ id: 'L2-1-잠실-잠실나루', from: '잠실', to: '잠실나루', directionCode: '1', points: path.points });
const reverseSegment = {
  id: 'L2-0-잠실나루-잠실', from: '잠실나루', to: '잠실', directionCode: '0' as const,
  lengthM: forward.segment.lengthM,
  curves: [...forward.segment.curves].reverse().map((curve, i) => ({ ...curve,
    id: `L2-0-잠실나루-잠실-osm-c${i + 1}`,
    startOffsetM: forward.segment.lengthM - curve.startOffsetM - curve.lengthM,
    turn: curve.turn === 'left' ? 'right' as const : 'left' as const,
  })),
};
const artifact = {
  provenance: { attribution: data.attribution, license: data.license, requestUrl: data.requestUrl,
    retrievedAt: data.retrievedAt, wayIds: path.wayIds,
    nodeIds: path.points.map((point) => point.nodeId),
    projection: 'Local east/north equirectangular plane, metres; origin first node',
    method: '20 m resampling, signed three-point curvature with 80 m baseline; median per same-turn run',
    limitations: 'Mapped representative rail only. Cant, actual traveled rail and positional accuracy unmeasured. 10 m coordinate perturbation is a sensitivity scenario, not an accuracy guarantee. Live guidance remains HOLD.',
  },
  points: path.points,
  diagnostics: forward.diagnostics,
  segments: [forward.segment, reverseSegment],
};
writeFileSync(new URL('../data/line2Centerline.ts', import.meta.url),
  `/** Generated by scripts/import-line2-centerline.mts. © OpenStreetMap contributors, ODbL 1.0. */\nimport type { RouteSegment } from '../contracts/index.ts';\n\nexport const LINE2_CENTERLINE = ${JSON.stringify(artifact, null, 2)} satisfies { segments: RouteSegment[]; [key: string]: unknown };\n`, 'utf8');
console.log(`Imported ${path.points.length} railway nodes, ${path.wayIds.length} ways, ${forward.segment.lengthM} m, ${forward.segment.curves.length} curves.`);

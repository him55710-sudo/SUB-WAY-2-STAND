{
  "expo": {
    "name": "SUB WAY 2 STAND",
    "slug": "sub-way-stand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sub-way-stand",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070B",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "열차가 역 사이에서 이미 멈춰 섰는지 감지하기 위해 동작 센서를 사용합니다. 정차를 예측하지는 않습니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
